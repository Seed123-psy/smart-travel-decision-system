APP_NAME=smart-travel-api
# Leave blank until a dedicated local database and credentials are configured.
DATABASE_URL=
# Example: mysql+asyncmy://smart_travel:URL_ENCODED_PASSWORD@127.0.0.1:3306/smart_travel?charset=utf8mb4
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Used by provider checks; requirement validation works without these values.
# Restart the API after editing .env. A filled value does not prove live connectivity.
LLM_API_KEY=
# OpenAI-compatible Chat Completions API root, including /v1 if required by your provider.
# HTTPS required for remote services; HTTP is supported only for local loopback models.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Amap Web Service key (not the JavaScript map SDK key).
AMAP_WEB_SERVICE_KEY=

# Optional flight reference (Amadeus for Developers Self-Service). Leave both
# blank to keep the flight page in clearly-labelled demo mode.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
